# ── Mobile (EXPO_PUBLIC_* is bundled into the app) ────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_LIVEKIT_URL=wss://your-livekit-url.livekit.cloud

# ── Backend only (never put these in EXPO_PUBLIC_*) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
ADMIN_SECRET=your-admin-secret   # used to approve hosts via PATCH /api/admin/hosts/:id/approve
